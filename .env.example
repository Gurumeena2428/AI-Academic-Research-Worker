# Copy this file to .env and add your own API key.
# Never commit .env or paste a real key into the repository.

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional OpenAI fallback:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

EMBEDDING_MODEL=all-MiniLM-L6-v2

CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
MIN_RETRIEVAL_SIMILARITY=0.20

CHROMA_COLLECTION_NAME=academic_documents
CORS_ORIGINS=http://localhost:3000
